# OCI MySQL HeatWave
MYSQL_HOST=replace-with-mysql-host
MYSQL_PORT=3306
MYSQL_USER=replace-with-private-user
MYSQL_PASSWORD=replace-with-private-password
MYSQL_DB=litellm_db

# Existing K3s Redis via Tailscale + Kong L4
REDIS_HOST=replace-with-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-private-password

# Optional local outbound proxy for Gemini API access
#HTTP_PROXY=http://127.0.0.1:7890
#HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,10.0.0.0/8

# Google Gemini API
OPENAI_API_KEY_FREE_1=replace-with-gemini-api-key-1
OPENAI_API_KEY_FREE_2=replace-with-gemini-api-key-2
OPENAI_API_KEY_FREE_3=replace-with-gemini-api-key-3
OPENAI_API_KEY_PRO_PLAN=replace-with-gemini-pro-plan-key

# LiteLLM Proxy
LITELLM_MASTER_KEY=replace-with-private-master-key
LITELLM_PORT=4000
FASTAPI_PORT=8000
