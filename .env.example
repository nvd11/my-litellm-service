# LiteLLM Control Plane (PostgreSQL - Neon Serverless / K3s)
DATABASE_URL=postgresql://replace-with-user:replace-with-password@replace-with-host:5432/neondb?sslmode=require

# LiteLLM Data Plane (OCI MySQL HeatWave)
MYSQL_HOST=replace-with-mysql-host
MYSQL_PORT=3306
MYSQL_USER=replace-with-private-user
MYSQL_PASSWORD=replace-with-private-password
MYSQL_DB=litellm_db

# Existing K3s Redis via Tailscale + Kong L4
REDIS_HOST=replace-with-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-private-password

# Currency FX Rate
DEFAULT_USD_TO_CNY_RATE=7.23

# Optional local outbound proxy for Gemini API access
#HTTP_PROXY=http://127.0.0.1:7890
#HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,10.0.0.0/8

# Google Gemini API
OPENAI_API_KEY_FREE_1=replace-with-gemini-api-key-1
OPENAI_API_KEY_FREE_2=replace-with-gemini-api-key-2
OPENAI_API_KEY_FREE_3=replace-with-gemini-api-key-3
OPENAI_API_KEY_PRO_PLAN=replace-with-gemini-pro-plan-key

# A6 API Relay (Fallback Tier)
A6_API_KEY=replace-with-a6-api-key

# Yuanheng (Meta) API Relay (gpt-5.6-luna premium group)
META_API_KEY=replace-with-meta-api-key

# LiteLLM Proxy
LITELLM_MASTER_KEY=replace-with-private-master-key
LITELLM_PORT=4000
FASTAPI_PORT=8000

# Dashboard CORS (comma-separated; defaults to local Vite dev/preview ports)
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
